{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/image/(.*)", "dest": "/index.js" },
    { "src": "/imgurl/(.*)", "dest": "/index.js" },
    { "src": "/settings.json", "dest": "/index.js" },
    { "src": "/search/(.*)", "dest": "/index.js" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
